{
  "name": "ludo-game-backend",
  "version": "1.0.0",
  "description": "Realtime Ludo Game Backend with Wallet System",
  "main": "src/server.js",
  "type": "commonjs",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
