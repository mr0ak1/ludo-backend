              "    }",
              "}"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{adminToken}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/admin/games?page=1&limit=10&status=&gameType=",
          "host": ["{{baseUrl}}"],
          "path": ["admin", "games"],
          "query": [
            {
              "key": "page",
              "value": "1"
            },
            {
              "key": "limit",
              "value": "10"
            },
            {
              "key": "status",
              "value": ""
            },
            {
              "key": "gameType",
              "value": ""
            }
          ]
        }
      }
    },
