        "body": {
          "mode": "raw",
          "raw": "{\n  \"userId\": \"{{testUserId}}\",\n  \"reason\": \"Temporary suspension\",\n  \"duration\": \"24h\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/admin/suspend-user",
          "host": ["{{baseUrl}}"],
          "path": ["admin", "suspend-user"]
        }
      }
    },
    {
      "name": "Get All Games",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "if (pm.response.code === 200) {",
              "    const games = pm.response.json().data.games;",
              "    if (games.length > 0) {",
              "        pm.environment.set('testGameId', games[0]._id);",
