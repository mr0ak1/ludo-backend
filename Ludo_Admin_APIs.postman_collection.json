{
  "info": {
    "_postman_id": "admin-apis-collection",
    "name": "Ludo Admin APIs",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Admin Login",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "if (pm.response.code === 200) {",
              "    pm.environment.set('adminToken', pm.response.json().data.token);",
              "    console.log('Admin token saved to environment');",
              "}"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"phone\": \"+919999999999\",\n  \"otp\": \"1234\",\n  \"sessionId\": \"session_id_here\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/admin/login",
          "host": ["{{baseUrl}}"],
          "path": ["admin", "login"]
        }
      }
    },
    {
      "name": "Get Dashboard",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{adminToken}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/admin/dashboard",
          "host": ["{{baseUrl}}"],
          "path": ["admin", "dashboard"]
        }
      }
    },
    {
      "name": "Get All Users",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "if (pm.response.code === 200) {",
              "    const users = pm.response.json().data.users;",
              "    if (users.length > 0) {",
              "        pm.environment.set('testUserId', users[0]._id);",
              "        console.log('Test user ID saved: ' + users[0]._id);",
              "    }",
              "}"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{adminToken}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/admin/users?page=1&limit=10&search=&isBanned=false",
          "host": ["{{baseUrl}}"],
          "path": ["admin", "users"],
          "query": [
            {
              "key": "page",
              "value": "1"
            },
            {
              "key": "limit",
              "value": "10"
            },
            {
              "key": "search",
              "value": ""
            },
            {
              "key": "isBanned",
              "value": "false"
            }
          ]
        }
      }
    },
    {
      "name": "Get Single User",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{adminToken}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/admin/user/{{testUserId}}",
          "host": ["{{baseUrl}}"],
          "path": ["admin", "user", "{{testUserId}}"]
        }
      }
    },
    {
      "name": "Ban User",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{adminToken}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"userId\": \"{{testUserId}}\",\n  \"reason\": \"Cheating detected\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/admin/ban-user",
          "host": ["{{baseUrl}}"],
          "path": ["admin", "ban-user"]
        }
      }
    },
    {
      "name": "Suspend User",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{adminToken}}"
          },
          {
            "key": "Content-Type",
